from pathlib import Path

content = """# ==========================================
# ConnectSphere - Root .gitignore
# Frontend + Node.js/Express Backend
# ==========================================

# Dependencies (frontend and backend)
node_modules/

# Environment variables and secrets
.env
.env.*
!.env.example

# Frontend / bundler build output
dist/
build/
coverage/
.next/
.nuxt/
.output/
out/
.vite/

# Backend runtime / generated files
uploads/
tmp/
temp/

# Logs and debug output
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Test and tooling caches
.nyc_output/
.eslintcache
.stylelintcache
.cache/
.parcel-cache/
.turbo/

# TypeScript build metadata
*.tsbuildinfo

# Local databases and runtime files
*.sqlite
*.sqlite3
*.db
*.pid
*.pid.lock

# Secrets / certificates / private keys
*.pem
*.key
*.p12
*.pfx

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# Editors and IDEs
.vscode/
.idea/
*.swp
*.swo

# Keep dependency lockfiles tracked:
# package-lock.json, yarn.lock, pnpm-lock.yaml
"""
path = Path("/mnt/data/.gitignore")
path.write_text(content, encoding="utf-8")
print(f"Created {path}")
